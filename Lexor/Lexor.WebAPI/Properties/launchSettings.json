{
  "$schema": "https://json.schemastore.org/launchsettings.json",
  "profiles": {
    "http": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": false,
      // "localhost" → server listens only on 127.0.0.1 (loopback) — local processes only.
      // "0.0.0.0"   → server listens on all network interfaces — accepts connections
      //               to any of the laptop's IP addresses (WiFi, Ethernet, etc.).
      "applicationUrl": "http://0.0.0.0:5170",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    "https": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": false,
      "applicationUrl": "https://0.0.0.0:7013;http://0.0.0.0:5170",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    }
  }
}
