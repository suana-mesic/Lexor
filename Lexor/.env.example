# Read by docker-compose to fill in the ${...} placeholders in docker-compose.yml.
# The per-service .env files (Lexor.WebAPI/.env, Lexor.Subscriber/.env) are separate and
# are used when the services run outside Docker.

# SQL Server 'sa' password. Must satisfy SQL Server's complexity rules.
DB_SA_PASSWORD=Your_Strong_SA_Password123!

# RabbitMQ credentials. The same pair is used to create the broker user and to build the
# connection strings for the API and the worker, so changing it here changes it everywhere.
# Note: the broker stores its users in the sqlserver/rabbit volume, so if you change these
# after the first run, recreate the stack with `docker compose down -v`.
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin
